# Frontend Public API URL (Render backend URL in production)
# In local development, leave blank to use Vite dev server proxy (/api)
VITE_API_URL=http://localhost:5000/api

# Frontend Socket.IO URL (Render backend URL in production)
# In local development, leave blank to use default (http://localhost:5000)
VITE_SOCKET_URL=http://localhost:5000

# Frontend Public Base URL for Customer QR Codes
# In production on Vercel: https://queueless.vercel.app (or your custom domain)
# In local development: http://localhost:5173
VITE_PUBLIC_URL=http://localhost:5173
