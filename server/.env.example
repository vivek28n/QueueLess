# Server Port & Host (Render sets PORT automatically; fallback to 5000 locally)
PORT=5000
HOST=0.0.0.0

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for multiple origins, e.g. Vercel domain + custom domain)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Development: mongodb://localhost:27017/queueless (or leave blank to auto-use persistent local engine)
# Production (Render / Atlas): mongodb+srv://<user>:<password>@cluster.mongodb.net/queueless?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/queueless

# JWT Configuration (Mandatory in production)
JWT_SECRET=your_strong_production_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d
